{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostMesh",
  "version": "0.2.5",
  "identifier": "com.neyordev.ghostmesh",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GhostMesh - Encrypted Mesh Overlay",
        "url": "index.html",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },


  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
